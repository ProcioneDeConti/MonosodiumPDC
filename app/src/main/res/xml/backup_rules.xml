<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for devices below API 31 (API 31+ uses data_extraction_rules.xml).
   Everything is backed up by default; the e6AI kill switch is explicitly excluded so a
   permanent local block can never travel to another device or a reinstall-with-restore.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/e6ai_lock.preferences_pb" />
</full-backup-content>

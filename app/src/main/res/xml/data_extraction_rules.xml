<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for API 31+. Everything is included by default; the e6AI kill
   switch (its own DataStore file) is excluded from both cloud backup and direct device transfer
   so a permanent local block can never leave this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/e6ai_lock.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/e6ai_lock.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
